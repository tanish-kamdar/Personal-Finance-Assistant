<% let counter=0,percentage=0,cssStyle='';%>
<div class="row  justify-content-evenly">
    <%for (const key in budget) {
        counter++;
        percentage=((budget[key].myTotalExpense)/(budget[key].advisedAllocation))*100;
        percentage=percentage.toString();
        cssStyle=`width: ${percentage} %`;
        %>

        <% if(counter>3 && counter%3==1) {%>
            <div class="w-100"></div>
            <% }%>
        <!-- Spending -->
    <div class="card expense-card col-3 mb-3"  >
        <div class="card-body">
            <h5 class="card-title"><%= key %></h5>
            <div class="progress-container">
                <div class="progress" role="progressbar" aria-label="Info example" aria-valuenow="<%=percentage%>" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar bg-info" id="<%=counter%>" style="width:<%=percentage%>%"></div>
                        </div>
                <p class="mt-2 text-muted">Used: ₹<%=budget[key].myTotalExpense%> / Budget: ₹<%= budget[key].advisedAllocation%></p>
            </div>
        </div>
    </div>
     <% } %>
</div>
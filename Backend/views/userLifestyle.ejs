<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Financial Profile</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <style>
        /* Optional: Add some custom styling if needed */
        
        .form-section-title {
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid #dee2e6; /* Light gray border */
            font-weight: bold;
        }
        .input-group .form-select {
            max-width: 80px; /* Adjust width for the unit selector */
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <%- include('includes/navbar.ejs') %>
    <div class="container">
        <h1 class="mb-4 mt-3" style="text-align: center;">Lifestyle</h1>
        <p class="text-muted mt-5">Please provide the following details to help us understand your financial situation.</p>

        <form action="/user/<%=id%>/lifestyle" method="POST" class="needs-validation" novalidate>
            <div class="row">
            <h2 class="h5 form-section-title mt-4">Basic Information</h2>

             <div class="mb-3">
                <label class="form-label">Type of Residence:</label>
                <div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="residenceType" id="residenceUrban" value="Urban" required>
                        <label class="form-check-label" for="residenceUrban">Urban</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="residenceType" id="residenceRural" value="Rural" required>
                        <label class="form-check-label" for="residenceRural">Rural</label>
                    </div>
                </div>
             </div>

            <div class="mb-3">
                <label for="city" class="form-label">Current City:</label>
                <input type="text" class="form-control" id="city" name="city" placeholder="e.g., Mumbai, Delhi, Bangalore" required>
                <div class="form-text">Living costs (rent, transport, food) vary significantly by city.</div>
            </div>

            <div class="mb-3">
                <label for="familySize" class="form-label">Family Size (including yourself):</label>
                <input type="number" class="form-control" id="familySize" name="familySize" placeholder="e.g., 4" min="1" step="1" required>
                <div class="form-text">Affects expenses like food, education, healthcare, and insurance.</div>
            </div>

             <div class="mb-3">
                <label class="form-label">Do you have significant Debt Obligations (e.g., Loans)?</label>
                <div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="hasDebt" id="debtYes" value="Yes" required>
                        <label class="form-check-label" for="debtYes">Yes</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="hasDebt" id="debtNo" value="No" required>
                        <label class="form-check-label" for="debtNo">No</label>
                    </div>
                </div>
                <div class="form-text">Debt repayments often need top priority in budgeting.</div>
             </div>

            <div class="mb-3">
                <label for="lifeStage" class="form-label">Current Life Stage:</label>
                <select class="form-select" id="lifeStage" name="lifeStage" required>
                    <option value="" selected disabled>-- Select One --</option>
                    <option value="Student">Student</option>
                    <option value="Working">Working Professional</option>
                    <option value="Retired">Retired</option>
                    <option value="Other">Other</option> </select>
                <div class="form-text">Influences priorities for income generation, education spending, retirement savings, etc.</div>
            </div>


            <h2 class="h5 form-section-title mt-4">Financial Goals</h2>

            <div class="mb-3 col-6">
                 <label for="savingsGoalValue" class="form-label">Monthly Savings Goal:</label>
                 <div class="input-group">
                    <input type="number" class="form-control" id="savingsGoalValue" name="savingsGoalValue" placeholder="e.g., 10000 or 20" min="0" step="any" required>
                    <select class="form-select" id="savingsGoalUnit" name="savingsGoalUnit" aria-label="Savings Goal Unit">
                        <option value="INR" selected>Rs.</option>
                        <option value="Percentage">%</option>
                    </select>
                 </div>
                 <div class="form-text">Specify your target savings amount per month, either as a fixed amount (Rs.) or as a percentage (%) of your total monthly income.</div>
            </div>


            <hr class="my-4"> <button type="submit" class="btn btn-success col-2 mb-3 mt-3">Submit Profile</button>
             <button type="reset" class="btn btn-danger ms-2 col-2 mb-3 mt-3">Reset Form</button>

            </div>
        </form>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="/app.js"></script>
    </body>
</html>